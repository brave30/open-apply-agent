# The offline demo requires none of these variables.
# Optional OpenWebRL checkout; defaults to vendor/OpenWebRL.
# OPENWEBRL_ROOT=/absolute/path/to/OpenWebRL
# Optional model API key for --endpoint. CLI does not load .env automatically.
# MODEL_API_KEY=place-your-key-here
# Optional custom cache location for local Hugging Face inference.
# HF_HOME=/absolute/path/to/model-cache
# For agent/demo --cloud-profile (only public client key; no service-role key).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Optional candidate JWT instead of interactive email/password sign-in:
# SUPABASE_ACCESS_TOKEN=YOUR_CANDIDATE_SESSION_JWT
