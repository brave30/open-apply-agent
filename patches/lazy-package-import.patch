+"""OpenWebRL exports, loaded lazily so browser-only inference needs no RL stack."""
+from importlib import import_module
+
+_MODULES = {
+    "Status": "base.types", "InteractionResult": "base.types", "EnvConfig": "base.types",
+    "ToolCall": "base.types", "ParsedToolResult": "base.types",
+    "BaseGymEnvAdapter": "base.adapter", "EnvRegistry": "base.registry",
+    "ToolParser": "base.utils", "TokenHandler": "base.utils",
+    "tools_to_openai_format": "base.utils", "calls_to_action": "base.utils",
+    "TOOL_INSTRUCTION": "base.utils", "generate_trajectory_sample": "generate_browser",
+    "generate_turn_sample": "generate_browser", "ENV_REGISTRY": "base.registry",
+}
+__all__ = list(_MODULES)
+
+def __getattr__(name):
+    if name not in _MODULES:
+        raise AttributeError(name)
+    attr = "DEFAULT_REGISTRY" if name == "ENV_REGISTRY" else name
+    value = getattr(import_module("openwebrl." + _MODULES[name]), attr)
+    globals()[name] = value
+    return value
